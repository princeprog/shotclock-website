# Server-side origin of the Shotclock API. The browser never calls it directly.
SHOTCLOCK_API_URL=http://localhost:3001
# Must match the API's PUBLIC_SITE_KEY (at least 32 bytes); gives the site its own rate-limit budget.
PUBLIC_SITE_KEY=replace-with-the-api-public-site-key
# Must match the API's WEBSITE_REVALIDATE_SECRET (at least 32 bytes); the API sends it to /api/revalidate.
WEBSITE_REVALIDATE_SECRET=replace-with-the-api-revalidate-secret
# Organizer sign-in (the Shotclock admin app) and this site's public origin, used for links and the sitemap.
ADMIN_APP_URL=http://localhost:3000
SITE_URL=http://localhost:3002
